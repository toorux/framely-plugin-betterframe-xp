{
  "name": "framely-plugin-betterframe-xp",
  "version": "0.1.0-preview.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ui": "node scripts/build.mjs --ui-only",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v && node tests/i18n.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:vulkan": "python3 tests/vulkan_smoke.py",
    "dev": "node scripts/preview.mjs",

    "release:prepare": "python3 scripts/release.py prepare",
    "release:assets": "python3 scripts/release.py assemble"
  },
  "dependencies": {"@framely/sdk": "file:vendor/framely-sdk", "react": "19.2.0", "react-dom": "19.2.0"},
  "devDependencies": {"@types/react": "19.2.0", "@types/react-dom": "19.2.0", "esbuild": "0.25.10", "typescript": "5.9.3"}
